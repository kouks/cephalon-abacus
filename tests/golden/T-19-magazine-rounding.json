{
  "id": "T-19",
  "question": "How do modded magazines round?",
  "bible": "§9",
  "gameVersion": "44.1.4.1",
  "reports": [
    {
      "on": "2026-11-24",
      "words": "Mag size rounds to nearest integer."
    },
    {
      "on": "2026-11-24",
      "words": "Braton with maxed magazine has 58 actually but with Tainted Mag (+66%) it has 75 so it rounds up but exact .5 rounds down."
    },
    {
      "on": "2026-11-24",
      "words": "Braton Prime with 1/5 Warp is indeed 50 mag."
    },
    {
      "on": "2026-11-25",
      "words": "Normal Vectis with Depleted Reload keeps 1."
    },
    {
      "on": "2026-11-25",
      "words": "Vectis PRIME with +25% gives 3."
    }
  ],
  "notes": "50 fits only Braton (45 rounds), not Braton Prime (75). 58.5 shows 58 because the product is 58.499996 in 32 bits; 49.5 and 2.5 are exact and round up. Vectis has 1 round, and 0.4 doesn't round to 0.",
  "tolerance": {
    "arsenal": 0
  },
  "cases": [
    {
      "name": "Braton with Magazine Warp",
      "scenario": {
        "build": {
          "weaponId": "braton",
          "modules": [
            {
              "moduleId": "magazine-warp"
            }
          ],
          "conditionals": {
