  "gameVersion": "44.1.4.1",
  "reports": [
    {
      "on": "2026-11-24",
      "words": "T14 - if a damage type is quantized to 0 it does not proc status despite the in-game overlay showing a non-0 chance (tested with -98% Puncture Jupiter and -117%+20% Slash Vectis)."
